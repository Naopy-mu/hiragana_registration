# First run: python scripts/bootstrap.py (creates an ignored .env with random secrets).
# Never commit .env or copy it into a deployment archive.
APP_ENV=development
BACKEND_MODE=local
APP_BASE_URL=http://127.0.0.1:8000
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
PAGE_CONFIG=config/pages.study.json
DATA_DIR=./data
COOKIE_SECURE=false
MAX_UPLOAD_MB=25

# Generate both values locally. Keep the quotes around the password hash ($ is literal).
# python scripts/set_password.py
RESEARCHER_PASSWORD_HASH=''
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Separate persistent secret for idempotent participant-link generation.
# Keep this value unchanged throughout the study (32+ characters).
PARTICIPANT_TOKEN_SECRET=

# Production only: Supabase Connect > Session pooler, include ?sslmode=require.
# Percent-encode any special characters in the database password.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
SUPABASE_URL=https://PROJECT_REF.supabase.co
# New server-side secret API key (sb_secret_...). Never use a publishable key here.
SUPABASE_SECRET_KEY=
# Legacy JWT service_role key fallback, only if a secret key is unavailable.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=handwriting-private
